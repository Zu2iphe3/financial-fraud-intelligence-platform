{
  "model_version": "paysim_fraud_model_v2_review",
  "experiment_name": "paysim-fraud-paysim_features_v2-validation-review",
  "feature_contract_path": "config/features/paysim_v2.json",
  "dataset_root": "data/processed/paysim_features/paysim_features_v2",
  "artifact_root": "artifacts/models/paysim_fraud_model_v2_review",
  "random_seed": 42,
  "primary_selection_metric": "validation_pr_auc",
  "threshold_policy": {
    "objective": "fraud_f1",
    "tie_breakers": ["fraud_recall", "false_positives", "threshold"],
    "reference_thresholds": [0.1, 0.25, 0.5, 0.75, 0.9],
    "reference_recall_targets": [0.5, 0.75, 0.8, 0.9]
  },
  "logistic_regression": {
    "C": 1.0,
    "class_weight": "balanced",
    "max_iter": 1000,
    "solver": "lbfgs"
  },
  "xgboost": {
    "objective": "binary:logistic",
    "eval_metric": "aucpr",
    "tree_method": "hist",
    "n_estimators": 500,
    "learning_rate": 0.05,
    "max_depth": 6,
    "min_child_weight": 10.0,
    "subsample": 0.8,
    "colsample_bytree": 1.0,
    "reg_alpha": 0.1,
    "reg_lambda": 5.0,
    "early_stopping_rounds": 40,
    "n_jobs": 4
  },
  "probability_parity_tolerance": 1e-7
}
