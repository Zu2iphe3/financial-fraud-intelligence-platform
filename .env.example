# Copy this file to .env for local development and replace placeholders locally.
# Docker Compose reads the database, user, password, and port.
# Python ingestion uses all PostgreSQL settings plus its configurable chunk size.
# Never commit the real .env file.

POSTGRES_DB=fraud_platform
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PAYSIM_INGESTION_CHUNK_SIZE=50000

# Airflow uses its own metadata database and local UI account. Choose local-only secrets.
# Use URL-safe characters for AIRFLOW_DB_PASSWORD because it is placed in a connection URL.
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace_with_a_local_airflow_database_password
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace_with_a_local_airflow_admin_password
AIRFLOW_ADMIN_EMAIL=admin@example.local
AIRFLOW_UI_PORT=8080
# Generate one long random local value; every Airflow service receives this same secret.
AIRFLOW_API_JWT_SECRET=replace_with_at_least_64_random_characters_for_local_task_tokens

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_TRANSACTION_TOPIC=paysim.transactions.v1
KAFKA_CONSUMER_GROUP=fraud-platform-postgres-v1
PAYSIM_REPLAY_START_ROW=1
PAYSIM_REPLAY_LIMIT=100
PAYSIM_REPLAY_RATE=10
KAFKA_DATABASE_RETRY_ATTEMPTS=3
KAFKA_DATABASE_RETRY_BACKOFF_SECONDS=2
MLFLOW_TRACKING_URI=http://localhost:5000

# FastAPI scores a complete v2 feature vector prepared by an upstream component.
# The host path contains the ignored model generated by the documented promotion step.
FRAUD_API_PORT=8000
FRAUD_MODEL_ARTIFACT_HOST_PATH=./artifacts/models/paysim_fraud_model_v2_scoring

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHROMA_PATH=./chroma_db
