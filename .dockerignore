# The Airflow image installs dependencies only; project code and raw data are mounted read-only.
**
!airflow/
airflow/**
!airflow/Dockerfile
!airflow/requirements.txt

# Build application code and committed contracts into the scoring image. The versioned
# approved model remains outside image history and is mounted read-only at runtime.
!api/
!api/**
!src/
!src/**
# Local bytecode can exist after tests but must not enter the runtime image.
src/**/__pycache__/
src/**/*.py[cod]
!config/
!config/api/
!config/api/**
!config/features/
!config/features/paysim_v2.json
